# Copy to .env and adjust. Consumed by docker-compose.yml.

# Git ref of rnpgp/rnp to build: a tag, branch or commit.
RNP_VERSION=main

# Crypto backend: openssl, botan or botan3.
#   openssl  system OpenSSL, nothing extra to build
#   botan    Botan, either major version accepted by RNP
#   botan3   Botan, version 3 required by RNP
# Both botan values build Botan from source at BOTAN_VERSION below, since
# Ubuntu packages only Botan 2. The backend also becomes part of the image
# tag, so builds with different backends do not overwrite each other.
CRYPTO_BACKEND=botan3

# Botan release to compile, as a tag of randombit/botan. Ignored when
# CRYPTO_BACKEND is openssl. Note that no 3.0.7 exists: the 3.0 series ends
# at 3.0.0, and releases continue at 3.1.0 through 3.13.0.
BOTAN_VERSION=3.13.0

# CMake build type: Release, Debug or RelWithDebInfo.
BUILD_TYPE=Release
